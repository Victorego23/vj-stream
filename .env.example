# Puerto del servidor
PORT=3000

# API Key de TorBox - BASE 1 Prioritaria Multi-IP (Obtenla en https://torbox.app/settings)
TORBOX_API_KEY=tu_token_de_torbox_aqui

# API Key de Real-Debrid - BASE 2 Respaldo de Ultra-Caché Latino (Obtenla en https://real-debrid.com/apitoken)
REALDEBRID_API_KEY=tu_token_de_real_debrid_aqui

# API Key / Token de TMDB (Obtenla en https://www.themoviedb.org/settings/api)
TMDB_API_KEY=tu_api_key_de_tmdb_aqui

# Configuración regional de TMDB
TMDB_LANGUAGE=es-ES

# Contraseña de Super Administrador (cámbiala en producción)
ADMIN_PASSWORD=tu_contraseña_segura_de_admin

# Clave secreta para generación de tokens de sesión y licencias
JWT_SECRET=clave_secreta_para_firmar_tokens_vj_stream

# Teléfono de soporte WhatsApp para avisos de renovación (ej: +51914598415)
WHATSAPP_NUMBER=+51914598415
